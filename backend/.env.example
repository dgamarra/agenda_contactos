# Backend Environment Variables
# Copia este archivo a .env y completa los valores

# Puerto del servidor
PORT=5000

# URI de MongoDB (local o Atlas)
MONGODB_URI=mongodb://localhost:27017/agenda_contactos

# JWT Secret (genera una cadena aleatoria segura)
JWT_SECRET=tu_jwt_secret_aqui_muy_largo_y_seguro_12345

# Entorno
NODE_ENV=development

# Tiempo de expiración del token (default: 7 días)
JWT_EXPIRE=7d

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100